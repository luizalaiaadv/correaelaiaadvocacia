# TYPEBOT_API_TOKEN: token de API do Typebot (Settings > My account > API tokens).
# Usado apenas no servidor para ler os resultados do bot.
TYPEBOT_API_TOKEN="MY_TYPEBOT_API_TOKEN"

# TYPEBOT_WORKSPACE_ID: id do workspace no Typebot.
TYPEBOT_WORKSPACE_ID="MY_TYPEBOT_WORKSPACE_ID"

# TYPEBOT_ID: id do typebot cujos resultados alimentam o dashboard.
TYPEBOT_ID="MY_TYPEBOT_ID"

# DASHBOARD_PASSWORD: senha de acesso à rota /dashboard.
DASHBOARD_PASSWORD="MY_DASHBOARD_PASSWORD"
